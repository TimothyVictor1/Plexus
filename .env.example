# Copy to .env. Never commit .env.
PLEXUS_ENV=development            # development | test | production
PLEXUS_LOG_LEVEL=INFO
# Where the console is served from, if not localhost. Comma-separated.
PLEXUS_CONSOLE_ORIGINS=

# The shared-link gate. Set a password and the whole console sits behind a confidentiality
# notice and that password, checked in middleware so it never reaches the browser. Leave it
# empty and there is no gate, which is what local development wants.
# These two belong to the console (dashboard/), not to the service.
PLEXUS_ACCESS_PASSWORD=
# Signs the cookie that says someone got through. Defaults to the password; set it separately
# so changing the password does not sign everyone out, and vice versa.
PLEXUS_GATE_SECRET=

# Model vendors (leave blank to run with local/sovereign profile only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
PLEXUS_MODEL_PROFILE=default      # default | sovereign

# Postgres (documents, vectors, event log, ledger, token vault)
# A managed Postgres hands out one URL. Set it and the five parts below are ignored.
# DATABASE_URL=postgresql://user:pass@host/plexus?sslmode=require
DATABASE_URL=
# How many connections one process may hold. Lower it on a serverless host, where many
# short-lived copies share one database.
POSTGRES_POOL_MAX=10
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=plexus
POSTGRES_USER=plexus
POSTGRES_PASSWORD=plexus

# Neo4j (knowledge graph). Set GRAPH_ENABLED=false on a host with no graph database: Plexus
# then runs on Postgres alone and the audit screen's map says there is none. Nothing a person
# uses day to day depends on it.
GRAPH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=plexuspassword

# Redis (event streams, sessions)
REDIS_URL=redis://localhost:6379/0

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# How the background jobs are scheduled. "temporal" keeps a durable worker and is the default.
# "cron" is for a host that cannot keep one alive: the same job functions are then called over
# HTTP, and CRON_SECRET is the shared secret that trigger must present.
JOBS_SCHEDULER=temporal
CRON_SECRET=

# Presidio
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=plexus-api

# Auth (Keycloak in compose)
OIDC_ISSUER=http://localhost:8080/realms/plexus
OIDC_CLIENT_ID=plexus-dashboard

# Token vault root key. This one key decides both how personal details are tokenised and how
# the vault holding them is encrypted, so it must never change once anything is stored.
# On a host with no durable disk, set PLEXUS_KMS_KEY instead of the file — and use the same
# value when seeding, or the tokens will not match what is stored.
#   python -c "import secrets;print(secrets.token_hex(32))"
PLEXUS_KMS_KEY=
PLEXUS_KMS_BACKEND=file
PLEXUS_KMS_FILE=./config/dev-kms.key
